# schedule-demo edge project only — NOT the app.kitchenstack-ai.com / KS_AI project.
# Invite edits belong here (ALLOWED_EMAILS), not only on app.

AUTH_SECRET=
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. Fail-closed: empty list denies all Google accounts.
ALLOWED_EMAILS=you@example.com,prospect@example.com

# Wave A Cloud Run demo (no public invoker). Edge attaches ID token.
# Set to your deployed service URL — do not commit the live origin.
CLOUD_RUN_ORIGIN=https://bc-schedule-agent-demo-YOUR_HASH-uc.a.run.app

# Optional: service-account JSON (single line) with roles/run.invoker on the demo service.
# Local smoke without SA leaves proxy unable to call Cloud Run (expected).
GCP_SA_JSON=
