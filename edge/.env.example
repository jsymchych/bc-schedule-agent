# schedule-demo edge project only — NOT the app.kitchenstack-ai.com / KS_AI project.
# Admit path: single-use signed invite URL (not Google OAuth).

# Shared HMAC secret for mint CLI + edge verify (crown jewel — never public git).
INVITE_SIGNING_SECRET=

# Optional separate session cookie secret (defaults to INVITE_SIGNING_SECRET).
SESSION_SECRET=

# Redeem ledger (required in production). Prefer one of:
# A) Vercel Blob (BLOB_STORE_ID via `vercel storage connect …`)
BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=   # optional if using token auth instead of OIDC
# B) Vercel KV / Upstash REST
KV_REST_API_URL=
KV_REST_API_TOKEN=
# C) GCS atomic object create (ifGenerationMatch=0) using GCP_SA_JSON
INVITE_REDEEM_GCS_BUCKET=
# Optional force: memory | blob | kv | gcs
# INVITE_REDEEM_BACKEND=blob

# Local/dev only — in-memory redeem ledger (NOT for prod).
# INVITE_REDEEM_BACKEND=memory

# Wave A Cloud Run demo (no public invoker). Edge attaches ID token.
# Set to your deployed service URL — do not commit the live origin.
CLOUD_RUN_ORIGIN=https://bc-schedule-agent-demo-YOUR_HASH-uc.a.run.app

# Optional: service-account JSON (single line) with roles/run.invoker on the demo service.
# Local smoke without SA leaves proxy unable to call Cloud Run (expected).
GCP_SA_JSON=

# Mint CLI default host (scripts/mint_invite.py)
# INVITE_BASE_URL=https://schedule-demo.kitchenstack-ai.com
