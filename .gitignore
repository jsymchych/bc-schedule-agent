# Accidental macOS / user shelves — never publish.
Library/
# Edge (Vercel) install / build artifacts — source under edge/ is versioned.
edge/node_modules/
edge/.next/
edge/.vercel/
edge/.env
edge/.env.local
edge/.env*.local
edge/.env.mint.local
edge/*.tsbuildinfo
# Secrets / SA material at any depth — never publish.
*.pem
*.p12
**/gcp-sa*.json
**/service-account*.json
**/*credentials*.json
# Rolling week shelf — runtime only; survives restart, not versioned.
artifacts/history/
# Named parameter shelf — runtime only; survives restart, not versioned.
artifacts/parameters/
